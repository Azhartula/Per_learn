.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.DS_Store
data/as.csv
*.egg-info/
dist/
build/

# Keep demo chart + lesson samples; ignore local noise if added later
outputs/**/__pycache__/
outputs/sessions/session_*
!outputs/sessions/demo_session.json
# Keep aggregated trajectory export; ignore one-offs if added later
outputs/trajectories/*
!outputs/trajectories/children.json
# Keep one live GPU sample; ignore extras
outputs/live_gpu/*
!outputs/live_gpu/live_meta.json
!outputs/live_gpu/*__live.md
!outputs/live_gpu/*.json

# Cursor: keep project rules only
.cursor/*
!.cursor/rules/
!.cursor/rules/**
